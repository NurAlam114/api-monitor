PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/api_monitor

# AI (Gemini). If the key is missing or the call fails, a template alert is used.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-3.6-flash
AI_TIMEOUT_MS=8000

# Anomaly thresholds
LATENCY_THRESHOLD_MS=3000
LATENCY_CRITICAL_MS=5000

# CORS (frontend origin)
CORS_ORIGIN=http://localhost:5173

# Optional email reports (leave blank to disable)
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
EMAIL_TO=
